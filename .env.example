# ============================================================================
# Environment variables for the Demo Studio template
# Copy this file to `.env` for local development (never commit `.env`).
# On Netlify: Site configuration → Environment variables.
# ============================================================================

# --- Anthropic (AI chatbot add-on) ------------------------------------------
# Used ONLY by the Netlify serverless function
# src/features/chatbot/api/chat.mjs — never exposed to the browser.
# Get a key at https://console.anthropic.com → API Keys.
# Only needed when featureFlags.aiChatbot is true (src/lib/site.config.js);
# the chatbot degrades gracefully (site still works) if this is missing.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the chatbot's Claude model (default: claude-opus-4-8).
# Cheaper options: claude-sonnet-4-6, claude-haiku-4-5.
# See docs/ADDON_CHATBOT.md for cost estimates.
# CHATBOT_MODEL=claude-opus-4-8

# That's it — this project needs no other environment variables.
# Calendly, contact details, and all content are configured in
# src/lib/site.config.js and src/lib/data.js (they are public values).
