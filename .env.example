# ============================================================================
# Environment variables for the Demo Studio template
# Copy this file to `.env` for local development (never commit `.env`).
# On Vercel: Project Settings → Environment Variables.
# ============================================================================

# --- Anthropic (AI chatbot) -------------------------------------------------
# Used ONLY by the serverless function api/chat.js — never exposed to the
# browser. Get a key at https://console.anthropic.com → API Keys.
# The chatbot silently degrades (site still works) if this is missing.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# That's it — this project needs no other environment variables.
# Calendly, contact details, and all content are configured in
# src/lib/site.config.js and src/lib/data.js (they are public values).
